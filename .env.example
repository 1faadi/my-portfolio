# Public canonical URL (no trailing slash). Used for canonical, Open Graph, and JSON-LD.
# Both https://sfak.space and https://www.sfak.space can serve the app; pick ONE as canonical:
#   VITE_SITE_URL=https://www.sfak.space
#   VITE_SITE_URL=https://sfak.space
# If unset while on sfak.space or www.sfak.space, metadata defaults to https://www.sfak.space
VITE_SITE_URL=https://www.sfak.space
